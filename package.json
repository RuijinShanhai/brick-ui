  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "prettier": "3.10.1",
    "sass": "1.83.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-svg-loader": "5.1.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.2.8",
    "@shikijs/transformers": "1.2.0",
    "@vue/compiler-sfc": "3.5.46",
    "@vueuse/core": "10.11.1",
    "@vueuse/shared": "10.11.1",
    "comment-parser": "1.4.1",
    "es-module-shims": "1.5.18",
    "gray-matter": "4.0.3",
    "lodash-es": "4.17.21",
    "lru-cache": "10.2.2",
    "shiki": "1.2.0",
    "splitpanes": "3.1.5",
    "sprintf-js": "1.1.3",
    "sucrase": "3.35.0",
    "vue": "3.5.46",
    "ant-design-vue": "4.1.2",
    "@ant-design/icons-vue": "7.0.1",
    "vitepress": "1.0.0-rc.45"
